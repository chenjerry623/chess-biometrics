.env

# Data is large (~4GB) and fully reproducible from the pipeline — never committed.
# Anchored to the repo root so it doesn't also match web/src/data/ (the small,
# deliberately-committed dataset the deployed site actually needs).
/data/

# Python
.venv/
.venv-py39-backup/
/source/
__pycache__/
*.pyc

# Generated by local CatBoost experiments — not project code
catboost_info/

# Web app
web/node_modules/
web/dist/
web/.vercel/

# Misc
.DS_Store
scratchpad/
.claude/
